# RAG 知识库服务（FastAPI + LangChain + Milvus）
# 本地开发时复制为 .env 使用；docker-compose 会自动从根目录 .env 注入

# JWT 认证：与后端共用的密钥（jwt.secret，root .env 中的 JWT_SECRET）
JWT_SECRET=请改成与后端一致的随机长字符串

# Milvus 向量数据库连接
RAG_MILVUS_URI=http://localhost:19530
# 若启用 Milvus 认证可设置: RAG_MILVUS_TOKEN=root:Milvus

# LLM —— OpenAI 兼容接口，复用根 .env 的 DEEPSEEK_*（base_url/api_key/model）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=请填入你的APIKey
DEEPSEEK_MODEL=deepseek-v4-pro
RAG_LLM_TEMPERATURE=0.2

# Embedding —— 复用根 .env 的 EMBEDDING_*
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=请填入你的APIKey

# 分块参数
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_DEFAULT_TOP_K=5
RAG_MAX_FILE_SIZE_MB=20