# RAG 知识库服务（FastAPI + LangChain + Milvus）
# 本地开发时复制为 .env 使用；docker-compose 会自动从根目录 .env 注入

# JWT 认证：与后端共用的密钥（jwt.secret，root .env 中的 JWT_SECRET）
JWT_SECRET=请改成与后端一致的随机长字符串

# Milvus 向量数据库连接
RAG_MILVUS_URI=http://localhost:19530
# 若启用 Milvus 认证可设置: RAG_MILVUS_TOKEN=root:Milvus

# LLM —— OpenAI 兼容接口（可指向 OpenAI / DeepSeek / 通义千问 / Kimi / 智谱 等）
RAG_LLM_BASE_URL=https://api.deepseek.com
RAG_LLM_API_KEY=sk-3e704fbdf30a4aa8896e2e2592bf4f2c
RAG_LLM_MODEL=deepseek-flash
RAG_LLM_TEMPERATURE=0.2

# Embedding 向量模型（也走 OpenAI 兼容接口，未配置时复用 LLM 的 base_url/api_key）
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_BASE_URL=https://llm-8nqvshp3cisw5mtg.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_API_KEY=sk-ws-H.PDPIMXM.iYyP.MEUCIQC8WCu95rP0oBePjHMPIrHLAOTMGo_mTiG7jnTeiqIYkgIgcr2E3T7iTQ1u0wmPZUVQ6CrbTHVYFDRLYSm9JEXM-tc

# 分块参数
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_DEFAULT_TOP_K=5
RAG_MAX_FILE_SIZE_MB=20