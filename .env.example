# 数据库（生产务必改成强密码）
MYSQL_ROOT_PASSWORD=请改成强密码
MYSQL_DATABASE=xuanhutong

# 应用密钥（生产务必改成随机长字符串）
JWT_SECRET=请改成随机长字符串

# 前端访问地址（换成你的 ECS 公网 IP 或域名）
APP_BASE_URL=http://你的ECS公网IP

# AI 辅助诊断（DeepSeek 大模型）
DEEPSEEK_API_KEY=请填入DeepSeek的APIKey
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# Embedding（阿里云 DashScope text-embedding-v4，OpenAI 兼容）
EMBEDDING_API_KEY=请填入阿里云百炼的APIKey
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# RAG 知识库（LangChain + Milvus，LLM 与 Embedding 均复用上方的 DEEPSEEK_* / EMBEDDING_*）

# Milvus 认证（默认未启用，无需修改）
# RAG_MILVUS_TOKEN=root:Milvus
