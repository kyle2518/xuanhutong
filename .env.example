# 数据库（生产务必改成强密码）
MYSQL_ROOT_PASSWORD=请改成强密码
MYSQL_DATABASE=xuanhutong

# 应用密钥（生产务必改成随机长字符串）
JWT_SECRET=请改成随机长字符串

# 前端访问地址（换成你的 ECS 公网 IP 或域名）
APP_BASE_URL=http://你的ECS公网IP

# RAG 知识库（LangChain + Milvus）
# LLM —— OpenAI 兼容接口（OpenAI / DeepSeek / 通义千问 / Kimi / 智谱 等均可）
RAG_LLM_BASE_URL=https://api.deepseek.com/v1
RAG_LLM_API_KEY=请填入你的APIKey
RAG_LLM_MODEL=deepseek-chat

# Embedding 向量模型（通义仅用于向量化，与聊天模型分开配置）
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_API_KEY=请填入你的APIKey

# Milvus 认证（默认未启用，无需修改）
# RAG_MILVUS_TOKEN=root:Milvus
